#!/usr/bin/env bash
# cctv-vpn: the CCTV server as the WireGuard hub for remote sites (hub and spoke). Run as root.
#
# Remote site gateways DIAL OUT to this hub on UDP 51820 (keepalive 25 s), so remote sites need
# no port forward and may sit behind 4G / carrier NAT. Site N (2..250) gets the tunnel address
# 10.77.0.N and the virtual subnet 10.78.N.0/24, which its gateway maps 1:1 onto its real LAN
# (the last octet is kept): an NVR at 192.168.1.10 at site 3 is added in the CCTV app as
# 10.78.3.10, port 6036. Sites may all use the same LAN range. There is no site 1: 10.77.0.1 is
# the hub itself.
# Least privilege: the hub never forwards; this machine may open only TCP 6036 and ping into
# the tunnel; nothing from a site can open a connection to this machine (web UI, SSH, ...).
#
#   cctv-vpn hub-init [--endpoint HOST[:PORT]|none] [--port N] [--mtu N] [--yes] [--new-hub-key]
#                                              set up / update (idempotent); --yes when the address
#                                              the sites dial changes while sites exist
#   cctv-vpn hub-info                          the main-site router / Windows instructions again
#   cctv-vpn hub-up | hub-down                 start / stop wg0 (hub-down: stays down after reboots)
#   cctv-vpn hub-rekey --yes                   new hub key pair (every site needs the new public key)
#   cctv-vpn hub-purge --yes [--delete-keys]   remove the hub (keeps /etc/cctv/vpn unless --delete-keys)
#   cctv-vpn backup --out FILE.tar.gz.gpg [--passphrase-file F] | --out FILE.tar.gz --no-encrypt
#   cctv-vpn restore FILE [--passphrase-file F] rebuild this hub from a backup (same keys: no site visits)
#   cctv-vpn firewall-reload                   rebuild and reload only the nftables table
#   cctv-vpn fw-verify                         is table inet cctv_vpn exactly as generated? (reloads it if not)
#   cctv-vpn site-add NAME --lan CIDR|none [--id N [--reuse-id]] [--pubkey KEY] [--psk-file F | --no-psk]
#                     [--note TEXT]
#   cctv-vpn site-set NAME|ID [--lan CIDR|none] [--rename NEW] [--note TEXT]
#   cctv-vpn site-remove NAME|ID --yes         cut the site off at once, delete its keys, retire its id
#   cctv-vpn site-rekey NAME|ID --yes [--pubkey KEY]
#   cctv-vpn site-reset NAME|ID                forget the site's handshake state (its clock went back)
#   cctv-vpn site-bundle NAME|ID [--out FILE.tar.gz|-] [--forget-key] [--no-key]
#   cctv-vpn site-list [--retired]
#   cctv-vpn status [--json|--write]           human view; --json for the app; --write = the 15 s timer
#   cctv-vpn check                             PASS/WARN/FAIL of every hub item (exit 1 on a FAIL)
#   (internal: post-up = wg0's PostUp; fw-verify --preup = wg0's PreUp; fw-watch = the watcher unit)
#
# Exit codes: 0 ok, 1 failed, 2 bad input or confirmation (--yes) missing, 3 conflict or not
# allowed, 4 not found.
#
# Files: /etc/cctv/vpn (0700, the source of truth: hub key, site records and keys), generated
# /etc/wireguard/wg0.conf, /etc/cctv/vpn/cctv_vpn.nft (table inet cctv_vpn), systemd units
# cctv-vpn-firewall.service, wg-quick@wg0 (+ drop-in), cctv-vpn-status.timer, cctv-vpn-fwwatch
# .service, /var/lib/cctv-vpn (saved site endpoints, the firewall's expected listing), and for the
# app /run/cctv/vpn-status.json (0644, no secrets). Operator guide: deploy/vpn/README.md.
#
# TESTS ONLY: CCTV_VPN_ROOT=<folder> puts every file under that folder, uses no systemd and acts
# on the current network namespace (refused in the main one); CCTV_VPN_IF / CCTV_VPN_TABLE then
# rename the interface and the nft table. deploy/vpn/test-sim.sh uses this.
set -euo pipefail
umask 077
export LC_ALL=C
PROG=cctv-vpn

# ---------------------------------------------------------------- messages
# under systemd, "<3>"/"<4>" set the journal level (the status timer logs notice and up only)
lvl() { [[ -n ${JOURNAL_STREAM:-} ]] && printf '<%s>' "$1"; return 0; }
die() { local code=$1; shift; printf '%s%s: %s\n' "$(lvl 3)" "$PROG" "$*" >&2; exit "$code"; }
warn() { printf '%s%s: WARNING: %s\n' "$(lvl 4)" "$PROG" "$*" >&2; }
q() { printf '%q' "$1"; } # untrusted text in messages
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
note() { printf '%s%s: %s\n' "$(lvl 5)" "$PROG" "$*" >&2; }
usage() { sed -n '2,47p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- validators
# every value from the command line, a record or wg is checked before it reaches a file name,
# a firewall rule, a config line or the JSON
RE_OCTET='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
RE_IP4="^($RE_OCTET\\.){3}$RE_OCTET\$"
# a DNS name as the site gateway accepts it (at least one dot, alphabetic top-level label)
RE_HOST='^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
valid_key() { [[ ${1:-} =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]]; }
valid_id() { [[ ${1:-} =~ ^([2-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|250)$ ]]; } # no 1: that is the hub
# a subset of what the app accepts ([a-z0-9-]{1,32}): no "-" at either end (a leading one reads
# as an option)
valid_name() { [[ ${1:-} =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]]; }
valid_uint() { [[ ${1:-} =~ ^[0-9]{1,18}$ ]]; } # fits bash arithmetic; printed as $((10#n))
valid_port() { [[ ${1:-} =~ ^[1-9][0-9]{0,4}$ ]] && ((10#$1 <= 65535)); }
valid_listen_port() { valid_port "${1:-}" && ((10#$1 >= 1024)); }
valid_mtu() { [[ ${1:-} =~ ^[0-9]{4}$ ]] && ((10#$1 >= 1280 && 10#$1 <= 1420)); }
valid_time() { [[ ${1:-} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; }
# a free-text note per site (device type, how to reach it): only in site.conf and site-list output,
# never in a rule, a file name or the status JSON; no quotes, $, backslash, backtick or control chars
RE_NOTE='^[A-Za-z0-9 .,:/_@()+#-]{0,100}$'
valid_note() { [[ ${1-} =~ $RE_NOTE ]]; }
valid_origin() { [[ ${1:-} =~ ^(hub|site|forgotten)$ ]]; } # where the site's private key was made / is
valid_ip4() { [[ ${1:-} =~ $RE_IP4 ]]; }
valid_ip6() { [[ ${1:-} =~ ^[0-9A-Fa-f:.]{2,45}$ && $1 == *:* ]]; }
valid_dns() { ((${#1} <= 253)) && [[ $1 =~ $RE_HOST ]]; }
valid_ep_host() { valid_ip4 "${1:-}" || valid_dns "${1:-}" || valid_ip6 "${1:-}"; }
valid_endpoint() { # ip4:port or [ip6]:port, as wg prints it (copy BASH_REMATCH first: the next
  local h p        # [[ =~ ]] inside valid_ip4/valid_port overwrites it)
  if [[ ${1:-} =~ ^([0-9.]+):([0-9]{1,5})$ ]]; then
    h=${BASH_REMATCH[1]} p=${BASH_REMATCH[2]}
    valid_ip4 "$h" && valid_port "$p"
    return
  fi
  if [[ ${1:-} =~ ^\[([0-9A-Fa-f:.]{2,45})(%[A-Za-z0-9_.-]{1,15})?\]:([0-9]{1,5})$ ]]; then
    p=${BASH_REMATCH[3]}
    valid_port "$p"
    return
  fi
  return 1
}
ip2int() { local a b c d; IFS=. read -r a b c d <<<"$1"; echo $(((a << 24) + (b << 16) + (c << 8) + d)); }
int2ip() { echo "$((($1 >> 24) & 255)).$((($1 >> 16) & 255)).$((($1 >> 8) & 255)).$(($1 & 255))"; }
mask_of() { if (($1 == 0)); then echo 0; else echo $(((0xFFFFFFFF << (32 - $1)) & 0xFFFFFFFF)); fi; }
valid_cidr4() { # a.b.c.d/p with the host bits zero
  [[ ${1:-} =~ ^([0-9.]+)/([0-9]|[12][0-9]|3[0-2])$ ]] || return 1
  local ip=${BASH_REMATCH[1]} len=${BASH_REMATCH[2]} n m
  valid_ip4 "$ip" || return 1
  n=$(ip2int "$ip")
  m=$(mask_of "$len")
  (((n & m) == n))
}
net_of() { # a.b.c.d/p (any host bits) -> its network a.b.c.0/p
  local ip=${1%/*} len=32
  [[ $1 == */* ]] && len=${1#*/}
  echo "$(int2ip $(($(ip2int "$ip") & $(mask_of "$len"))))/$len"
}
cidr_contains() { # outer-cidr inner-cidr-or-ip
  local o=${1%/*} ol=${1#*/} i=${2%/*} il=32 m
  [[ $2 == */* ]] && il=${2#*/}
  ((il >= ol)) || return 1
  m=$(mask_of "$ol")
  ((($(ip2int "$i") & m) == ($(ip2int "$o") & m)))
}
cidr_overlap() { cidr_contains "$1" "$2" || cidr_contains "$2" "$1"; }
is_private_net() { cidr_contains 10.0.0.0/8 "$1" || cidr_contains 172.16.0.0/12 "$1" || cidr_contains 192.168.0.0/16 "$1"; }
lan_problem() { # why a site LAN is not acceptable (prints nothing when it is fine)
  valid_cidr4 "$1" || { echo "not a network like 192.168.1.0/24 (with the host part 0)"; return 0; }
  [[ ${1#*/} == 24 ]] || { echo "must be one /24: the virtual subnet 10.78.N.0/24 maps it host by host (for a bigger LAN give the /24 that holds the NVRs)"; return 0; }
  is_private_net "$1" || { echo "not a private network (10/8, 172.16/12, 192.168/16)"; return 0; }
  if cidr_overlap "$1" "$TUNNEL_NET"; then echo "overlaps the VPN tunnel network $TUNNEL_NET"; return 0; fi
  if cidr_overlap "$1" "$VIRTUAL_NET"; then echo "overlaps the VPN virtual networks $VIRTUAL_NET"; return 0; fi
  return 0
}
check_lan_arg() { # --lan value (CIDR or none), exit 2 when bad
  [[ $1 == none ]] && return 0
  local why
  why=$(lan_problem "$1")
  [[ -z $why ]] || die 2 "--lan $(q "$1"): $why"
}
check_new_name() {
  valid_name "$1" || die 2 "site name $(q "$1"): use 1-32 of a-z 0-9 and -, not starting or ending with -"
  [[ ! $1 =~ ^[0-9]+$ ]] || die 2 "site name $(q "$1"): a name of only digits would be mistaken for a site id"
}

# ---------------------------------------------------------------- paths and test mode
netns_is_main() { # 0 = the main network namespace (or unknown: then assume the main one)
  local a b
  a=$(readlink /proc/self/ns/net 2>/dev/null) || return 0
  b=$(readlink /proc/1/ns/net 2>/dev/null) || return 0
  [[ $a == "$b" ]]
}
ROOT=""
IF=wg0
TABLE=cctv_vpn
TEST_MODE=0
if [[ -n ${CCTV_VPN_ROOT:-} ]]; then
  ROOT=${CCTV_VPN_ROOT%/}
  [[ $ROOT =~ ^/[A-Za-z0-9._/-]+$ && $ROOT != *..* && -d $ROOT ]] || die 2 "CCTV_VPN_ROOT must be an existing absolute folder (letters, digits, . _ - /)"
  TEST_MODE=1
  IF=${CCTV_VPN_IF:-wg0}
  TABLE=${CCTV_VPN_TABLE:-cctv_vpn}
  [[ $IF =~ ^[a-z][a-z0-9_-]{0,14}$ ]] || die 2 "CCTV_VPN_IF: bad interface name"
  [[ $TABLE =~ ^[a-z][a-z0-9_]{0,31}$ ]] || die 2 "CCTV_VPN_TABLE: bad table name"
  if netns_is_main; then die 3 "CCTV_VPN_ROOT is for tests inside a network namespace (ip netns exec ...): refused in the main namespace"; fi
elif [[ -n ${CCTV_VPN_IF:-}${CCTV_VPN_TABLE:-} ]]; then
  die 2 "CCTV_VPN_IF / CCTV_VPN_TABLE are for tests and work only together with CCTV_VPN_ROOT"
fi
VPN_DIR=$ROOT/etc/cctv/vpn
SITES=$VPN_DIR/sites
RETIRED=$VPN_DIR/retired
BUNDLES=$VPN_DIR/bundles
NFT_FILE=$VPN_DIR/cctv_vpn.nft
WG_DIR=$ROOT/etc/wireguard
WG_CONF=$WG_DIR/$IF.conf
STATE_DIR=$ROOT/var/lib/cctv-vpn # last known site endpoints, the firewall's listing (not secret)
FW_EXPECTED=$STATE_DIR/table.expected # the table as this tool loaded it (counters left out)
FLIPS=$STATE_DIR/endpoint-changes     # recent endpoint changes per site (two holders of one key?)
BACKUP_CONF=$VPN_DIR/backup.conf      # when the last backup was made / the last change
RUN_DIR=$ROOT/run/cctv
STATUS_FILE=$RUN_DIR/vpn-status.json
UNIT_DIR=$ROOT/etc/systemd/system
TMPFILES_CONF=$ROOT/etc/tmpfiles.d/cctv-vpn.conf
SBIN=$ROOT/usr/local/sbin/cctv-vpn
SHARE=$ROOT/usr/local/share/cctv-vpn
FW_UNIT=cctv-vpn-firewall.service
WG_UNIT=wg-quick@$IF.service
ST_UNIT=cctv-vpn-status.service
TIMER_UNIT=cctv-vpn-status.timer
WATCH_UNIT=cctv-vpn-fwwatch.service
MARKER="# managed by cctv-vpn: rebuilt from /etc/cctv/vpn on every change, edits here are lost"
HUB_IP=10.77.0.1
TUNNEL_NET=10.77.0.0/24
VIRTUAL_NET=10.78.0.0/16
NVR_PORT=6036
KEEPALIVE=25
CONNECTED_S=180
if ((TEST_MODE)); then
  POSTUP="env CCTV_VPN_ROOT=$ROOT CCTV_VPN_IF=$IF CCTV_VPN_TABLE=$TABLE $SBIN"
else
  POSTUP=/usr/local/sbin/cctv-vpn
fi

CLEANUP_DIRS=() # temporary folders to remove on exit (site-bundle, backup, restore)
GPG_HOMES=()    # temporary gpg homes: their gpg-agent is stopped on exit
GPG_RUNDIR=""   # /run/user/<uid>/gnupg when gpg made it for this command (removed again if empty)
on_exit() {
  local d
  for d in "${GPG_HOMES[@]}"; do
    HOME=$d gpgconf --homedir "$d" --kill gpg-agent >/dev/null 2>&1 || true
    HOME=$d gpgconf --homedir "$d" --remove-socketdir >/dev/null 2>&1 || true
  done
  [[ -z $GPG_RUNDIR ]] || rmdir -- "$GPG_RUNDIR" 2>/dev/null || true
  for d in "${CLEANUP_DIRS[@]}"; do [[ -z $d ]] || rm -rf -- "$d"; done
}
trap on_exit EXIT
need_root() { [[ $(id -u) == 0 ]] || die 3 "run as root (sudo $PROG ...)"; }
need_tools() {
  local t missing=()
  for t in "$@"; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
  ((${#missing[@]} == 0)) || die 3 "missing tools: ${missing[*]} (Ubuntu: apt install wireguard-tools nftables)"
}
is_wsl() { [[ $(systemd-detect-virt 2>/dev/null || true) == wsl ]] || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; }
LOCKED=0
lock() { # one changing command at a time
  ((LOCKED)) && return 0
  [[ -d $VPN_DIR ]] || die 4 "the hub is not set up ($VPN_DIR missing): run $PROG hub-init"
  exec 9>>"$VPN_DIR/.lock"
  flock -w 30 9 || die 3 "another $PROG command is still running (lock $VPN_DIR/.lock)"
  LOCKED=1
}

# ---------------------------------------------------------------- records (KEY=value, never sourced)
read_record() { # file assoc-array-name; 1 if missing or any line is not KEY=value
  local file=$1 line k
  local -n into=$2
  into=()
  [[ -f $file && ! -L $file ]] || return 1
  # split at the FIRST "=" by hand: `IFS== read k v` drops the "=" at the end of a base64 key
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || return 1
    k=${line%%=*}
    [[ $k =~ ^[A-Z_]{1,32}$ ]] || return 1
    [[ -z ${into[$k]+x} ]] || return 1
    into[$k]=${line#*=}
  done <"$file"
  return 0
}
write_kv_file() { # file KEY=VALUE... (values validated by the caller); atomic
  local file=$1 tmp
  shift
  tmp=$(mktemp "${file%/*}/.${file##*/}.XXXXXX")
  { printf '# written by %s (no secrets). Do not edit while a %s command runs.\n' "$PROG" "$PROG"; printf '%s\n' "$@"; } >"$tmp"
  chmod 600 "$tmp"
  sync "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$file"
}
read_key_file() { # prints the key in a one-key file; 1 if missing or not a key
  local v
  [[ -f $1 && ! -L $1 ]] || return 1
  v=$(head -c 200 "$1" | tr -d ' \t\r\n')
  valid_key "$v" || return 1
  printf '%s' "$v"
}
write_secret() { # file value: a 0600 key file, atomic
  local tmp
  tmp=$(mktemp "${1%/*}/.${1##*/}.XXXXXX")
  printf '%s\n' "$2" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$1"
}

declare -A HUB=() S=() P=() R=()
H_ENDPOINT="" H_PUBLIC_PORT="" H_PORT="" H_MTU="" H_CREATED="" HUB_PUB="" HUB_HINT=""
ep_join() { # host port -> host:port, [v6]:port, or nothing
  [[ -n $1 ]] || return 0
  if [[ $1 == *:* ]]; then printf '[%s]:%s' "$1" "$2"; else printf '%s:%s' "$1" "$2"; fi
}
load_hub() { # hub.conf + hub.pub -> H_* HUB_PUB HUB_HINT
  local k
  read_record "$VPN_DIR/hub.conf" HUB || die 4 "the hub is not set up ($VPN_DIR/hub.conf missing or unreadable): run $PROG hub-init"
  for k in "${!HUB[@]}"; do case $k in ENDPOINT | PUBLIC_PORT | PORT | MTU | CREATED) ;; *) die 1 "hub.conf: unknown setting $k" ;; esac; done
  H_ENDPOINT=${HUB[ENDPOINT]:-}
  H_PORT=${HUB[PORT]:-}
  H_PUBLIC_PORT=${HUB[PUBLIC_PORT]:-$H_PORT}
  H_MTU=${HUB[MTU]:-1280}
  H_CREATED=${HUB[CREATED]:-}
  valid_listen_port "$H_PORT" || die 1 "hub.conf: bad PORT"
  valid_port "$H_PUBLIC_PORT" || die 1 "hub.conf: bad PUBLIC_PORT"
  valid_mtu "$H_MTU" || die 1 "hub.conf: bad MTU"
  [[ -z $H_ENDPOINT ]] || valid_ep_host "$H_ENDPOINT" || die 1 "hub.conf: bad ENDPOINT"
  HUB_PUB=$(read_key_file "$VPN_DIR/hub.pub") || die 1 "$VPN_DIR/hub.pub missing or not a key"
  HUB_HINT=$(ep_join "$H_ENDPOINT" "$H_PUBLIC_PORT")
}
load_site() { # id [array, default S] -> that array holds the checked record; 1 when missing or bad
  # (loops over all sites use P, so that S keeps the site a command works on)
  local id=$1 arr=${2:-S} k
  local -n _ls=$arr
  valid_id "$id" || return 1
  read_record "$SITES/$id/site.conf" "$arr" || return 1
  for k in "${!_ls[@]}"; do case $k in ID | NAME | LAN | PUBLIC_KEY | PSK | KEY_ON_HUB | KEY_ORIGIN | CREATED | EXPORTED | NOTE) ;; *) return 1 ;; esac; done
  [[ ${_ls[ID]:-} == "$id" ]] || return 1
  valid_name "${_ls[NAME]:-}" || return 1
  [[ ${_ls[LAN]:-} == none || (-n ${_ls[LAN]:-} && -z $(lan_problem "${_ls[LAN]}")) ]] || return 1
  valid_key "${_ls[PUBLIC_KEY]:-}" || return 1
  [[ ${_ls[PSK]:-} =~ ^(yes|no)$ && ${_ls[KEY_ON_HUB]:-} =~ ^(yes|no)$ ]] || return 1
  valid_time "${_ls[CREATED]:-}" || return 1
  _ls[EXPORTED]=${_ls[EXPORTED]:-never}
  [[ ${_ls[EXPORTED]} == never ]] || valid_time "${_ls[EXPORTED]}" || return 1
  # records written before KEY_ORIGIN existed: a key on the hub was made here, else at the site
  if [[ -z ${_ls[KEY_ORIGIN]:-} ]]; then if [[ ${_ls[KEY_ON_HUB]} == yes ]]; then _ls[KEY_ORIGIN]=hub; else _ls[KEY_ORIGIN]=site; fi; fi
  valid_origin "${_ls[KEY_ORIGIN]}" || return 1
  if [[ ${_ls[KEY_ON_HUB]} == yes && ${_ls[KEY_ORIGIN]} != hub ]] || [[ ${_ls[KEY_ON_HUB]} == no && ${_ls[KEY_ORIGIN]} == hub ]]; then return 1; fi
  _ls[NOTE]=${_ls[NOTE]:-}
  valid_note "${_ls[NOTE]}" || return 1
  return 0
}
save_site() { # folder (from S)
  write_kv_file "$1/site.conf" "ID=${S[ID]}" "NAME=${S[NAME]}" "LAN=${S[LAN]}" "PUBLIC_KEY=${S[PUBLIC_KEY]}" \
    "PSK=${S[PSK]}" "KEY_ON_HUB=${S[KEY_ON_HUB]}" "KEY_ORIGIN=${S[KEY_ORIGIN]}" "CREATED=${S[CREATED]}" \
    "EXPORTED=${S[EXPORTED]}" "NOTE=${S[NOTE]:-}"
}
# the backup is out of date after every change of keys or site records
mark_changed() {
  local last="never"
  local -A B=()
  if read_record "$BACKUP_CONF" B 2>/dev/null && valid_time "${B[LAST_BACKUP]:-}"; then last=${B[LAST_BACKUP]}; fi
  write_kv_file "$BACKUP_CONF" "LAST_BACKUP=$last" "LAST_CHANGE=$(now_iso)"
  if [[ $last == never ]]; then
    note "no backup of this hub yet: $PROG backup --out <file on another machine or a USB stick> (README: Back up the hub)"
  else
    note "the last backup ($last) is now out of date: make a new one ($PROG backup --out ...)"
  fi
}
load_retired() { # id -> R; 1 when missing or bad
  valid_id "$1" && read_record "$RETIRED/$1.conf" R && valid_name "${R[NAME]:-}" && valid_time "${R[REMOVED]:-}"
}
site_ids() { # active sites, by id
  local d id
  for d in "$SITES"/*/; do
    id=${d%/}
    id=${id##*/}
    if valid_id "$id" && [[ -f $SITES/$id/site.conf ]]; then printf '%s\n' "$id"; fi
  done | sort -n
}
retired_ids() {
  local f id
  for f in "$RETIRED"/*.conf; do
    id=${f##*/}
    id=${id%.conf}
    if valid_id "$id" && [[ -f $f ]]; then printf '%s\n' "$id"; fi
  done | sort -n
}
site_id_by_name() { # name -> id of the active site with that name; 1 if none
  local id
  for id in $(site_ids); do
    if load_site "$id" P && [[ ${P[NAME]} == "$1" ]]; then
      printf '%s' "$id"
      return 0
    fi
  done
  return 1
}
FOUND=""
find_site() { # NAME|ID -> FOUND and S; exit 2/4
  local arg=$1 id
  [[ -n $arg ]] || die 2 "give a site name or id"
  if valid_id "$arg" && [[ -d $SITES/$arg ]]; then
    load_site "$arg" || die 1 "site $arg: the record $SITES/$arg/site.conf is damaged"
    FOUND=$arg
    return 0
  fi
  valid_name "$arg" || die 2 "not a site name or id: $(q "$arg")"
  id=$(site_id_by_name "$arg") || die 4 "no active site $(q "$arg") ($PROG site-list)"
  load_site "$id" || die 1 "site $id: damaged record"
  FOUND=$id
}
next_free_id() { # lowest id that was never used (removed ids stay retired)
  local i
  for ((i = 2; i <= 250; i++)); do
    if [[ ! -e $SITES/$i && ! -e $RETIRED/$i.conf ]]; then
      printf '%s' "$i"
      return 0
    fi
  done
  return 1
}
used_pubkey() { # key -> name of the site using it; 1 if none
  local id
  for id in $(site_ids); do
    if load_site "$id" P && [[ ${P[PUBLIC_KEY]} == "$1" ]]; then
      printf '%s' "${P[NAME]}"
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------- generated files
render_nft() {
  cat <<EOF
#!/usr/sbin/nft -f
# CCTV VPN hub firewall. Generated by cctv-vpn (hub-init / firewall-reload): edits here are lost.
# Loaded with \`nft -f\` as ONE transaction that replaces only table inet $TABLE: ufw, Docker, WSL's
# own tables etc. are never touched. A drop here is final whatever other tables say; an accept
# here does not override their drops (with ufw active: ufw allow $H_PORT/udp).
# Policy for $IF (least privilege):
#   - nothing from a site may open a connection to this host (web UI, SSH, ...): only replies to
#     connections this host opened come back in;
#   - this host may open only TCP $NVR_PORT (TVT SDK) and ping into the tunnel;
#   - this host never forwards to or from $IF (even if ip_forward gets switched on);
#   - the VPN ranges never leave through any other interface (e.g. while $IF is down).
# cctv-vpn compares the live table with what it loaded: the watcher unit and the 15 s timer put it
# back at once when anything flushes, deletes or edits it, and take $IF down if that fails.

add table inet $TABLE
delete table inet $TABLE

table inet $TABLE {
	set vpn4 {
		type ipv4_addr
		flags interval
		elements = { $TUNNEL_NET, $VIRTUAL_NET }
	}

	# WireGuard never answers strangers, so these show what reaches this host at all: every
	# packet for the WireGuard port, and handshake initiations (message type 1)
	counter wg_udp_in {
	}
	counter wg_handshake_in {
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname "$IF" jump from_sites
		udp dport $H_PORT counter name "wg_udp_in"
		udp dport $H_PORT @th,64,32 0x01000000 counter name "wg_handshake_in"
	}

	chain from_sites {
		ct state established,related counter accept
		limit rate 6/minute burst 5 packets log prefix "cctv-vpn drop in: " level info
		counter drop
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname "$IF" counter drop
		oifname "$IF" counter drop
	}

	chain output {
		type filter hook output priority filter; policy accept;
		oifname "$IF" jump to_sites
		oifname != "lo" ip daddr @vpn4 counter reject with icmp type admin-prohibited
	}

	chain to_sites {
		ip daddr @vpn4 tcp dport $NVR_PORT counter accept
		ip daddr @vpn4 icmp type echo-request counter accept
		limit rate 6/minute burst 5 packets log prefix "cctv-vpn drop out: " level info
		# reject, not drop: a wrong port fails at once ("no route to host") instead of timing out
		meta nfproto ipv4 counter reject with icmp type admin-prohibited
		counter drop
	}
}
EOF
}
write_nft() { # render, check with nft -c, then replace the file
  local tmp
  tmp=$(mktemp "$VPN_DIR/.cctv_vpn.nft.XXXXXX")
  render_nft >"$tmp"
  chmod 600 "$tmp"
  if ! nft -c -f "$tmp" >/dev/null; then
    rm -f "$tmp"
    die 1 "the generated firewall does not load (nft -c failed): nothing changed"
  fi
  mv -f "$tmp" "$NFT_FILE"
}
render_wg_conf() {
  local id psk hubkey
  hubkey=$(read_key_file "$VPN_DIR/hub.key") || die 1 "$VPN_DIR/hub.key missing or not a key"
  echo "$MARKER"
  echo "[Interface]"
  echo "Address = $HUB_IP/24"
  echo "ListenPort = $H_PORT"
  echo "PrivateKey = $hubkey"
  echo "MTU = $H_MTU"
  echo "Table = off"
  # wg0 never starts unless table inet $TABLE is loaded and exactly as generated (fail closed)
  echo "PreUp = $POSTUP fw-verify --preup"
  echo "PostUp = ip -4 route replace $VIRTUAL_NET dev %i"
  echo "PostUp = $POSTUP post-up %i"
  for id in $(site_ids); do
    if ! load_site "$id" P; then
      warn "site $id: damaged record $SITES/$id/site.conf: left out of $IF (fix or remove it)"
      continue
    fi
    psk=""
    if [[ ${P[PSK]} == yes ]] && ! psk=$(read_key_file "$SITES/$id/psk"); then
      warn "site $id (${P[NAME]}): psk file missing or bad: left out of $IF"
      continue
    fi
    echo
    echo "[Peer]"
    echo "# site $id ${P[NAME]} (${P[LAN]} there)"
    echo "PublicKey = ${P[PUBLIC_KEY]}"
    [[ -z $psk ]] || echo "PresharedKey = $psk"
    echo "AllowedIPs = 10.77.0.$id/32, 10.78.$id.0/24"
    # (no PersistentKeepalive here: post-up sets it once the saved endpoints are in, see ensure_keepalive)
  done
  return 0
}
write_wg_conf() { # atomic; refuses to replace a wg0.conf that this tool did not write
  local tmp
  if [[ -e $WG_CONF && "$(head -n1 "$WG_CONF" 2>/dev/null)" != "$MARKER" ]]; then
    die 3 "$WG_CONF exists and was not written by $PROG: move it away first (another WireGuard setup on $IF?)"
  fi
  install -d -m 0700 "$WG_DIR"
  tmp=$(mktemp "$WG_DIR/.$IF.conf.XXXXXX")
  render_wg_conf >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$WG_CONF"
}
write_units() { # systemd units, drop-ins, tmpfiles entry (the same text in test mode, under ROOT)
  local nft
  nft=$(command -v nft)
  install -d -m 0755 "$UNIT_DIR" "$UNIT_DIR/wg-quick@$IF.service.d" "$UNIT_DIR/nftables.service.d" "${TMPFILES_CONF%/*}"
  cat >"$UNIT_DIR/$FW_UNIT" <<EOF
# CCTV VPN hub firewall: loads ONLY table inet $TABLE (nft -f replaces it atomically).
# Written by cctv-vpn hub-init. wg-quick@$IF requires this unit, so $IF never runs without it.
#   systemctl status $FW_UNIT      nft list table inet $TABLE      cctv-vpn firewall-reload
[Unit]
Description=CCTV VPN hub firewall (nftables table inet $TABLE)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target wg-quick@$IF.service shutdown.target
# nftables.service starts with "flush ruleset": load after it, never before
