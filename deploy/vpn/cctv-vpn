render_bundle_wgconf() { # $1 private key or empty, $2 psk or empty
  echo "# CCTV VPN: site ${S[ID]} (${S[NAME]}) -> the CCTV server. For routers and WireGuard for Windows."
  echo "# Linux gateways: do not use this file; run site-gateway.sh install <bundle> instead."
  echo "[Interface]"
  if [[ -n $1 ]]; then echo "PrivateKey = $1"; else echo "# PrivateKey = (not in this bundle: the gateway's own key, which is already on the device)"; fi
  echo "Address = 10.77.0.${S[ID]}/32"
  echo "MTU = $H_MTU"
  echo
  echo "[Peer]"
  echo "# the CCTV server (hub)"
  echo "PublicKey = $HUB_PUB"
  [[ -z $2 ]] || echo "PresharedKey = $2"
  echo "Endpoint = $B_HINT"
  echo "AllowedIPs = $HUB_IP/32"
  echo "PersistentKeepalive = $KEEPALIVE"
}
bundle_key_text() { # $1 has key (yes/no): what the bundle's README says about the private key
  if [[ $1 == yes ]]; then
    echo "This bundle holds the site's WireGuard PRIVATE KEY (site.key, wg0.conf): treat it like a password."
    echo "Whoever has a copy can stand in for this site's gateway from anywhere and receive the CCTV app's"
    echo "NVR logins for this site. Copy it to the site over a secure channel, install it, then delete every copy."
  elif [[ ${S[KEY_ORIGIN]} == site ]]; then
    echo "This bundle holds NO private key: the gateway uses the key it made itself (its public key is below)."
  elif [[ ${S[KEY_ORIGIN]} == forgotten ]]; then
    echo "This bundle holds NO private key: the site's key was exported on ${S[EXPORTED]} and then forgotten on"
    echo "the CCTV server. The gateway must still have it (Linux: the PrivateKey line of"
    echo "/etc/wireguard/wg-cctv.conf, given to the install with --key FILE); if not: cctv-vpn site-rekey."
  else
    echo "This bundle was made without the private key (--no-key): the gateway must still have it"
    echo "(Linux: the PrivateKey line of /etc/wireguard/wg-cctv.conf, given to the install with --key FILE)."
  fi
}
render_bundle_readme() { # $1 folder name, $2 has key (yes/no)
  local id=${S[ID]} lanword
  if [[ ${S[LAN]} == none ]]; then lanword="not recorded on the hub: the Linux gateway uses its own /24"; else lanword="${S[LAN]} (10.78.$id.x on the CCTV server = ${S[LAN]%.*}.x here)"; fi
  cat <<EOF
CCTV VPN: bundle for site $id (${S[NAME]}), made at $(now_iso)
$(bundle_key_text "$2")

  site id           $id
  site name         ${S[NAME]}
  tunnel address    10.77.0.$id/32  (the site gateway inside the VPN)
  virtual subnet    10.78.$id.0/24  (how the CCTV server sees this site's LAN)
  site LAN          $lanword
  CCTV server       $B_HINT (UDP; the site dials out: no port forward is needed at the site)
  hub public key    $HUB_PUB
  site public key   ${S[PUBLIC_KEY]}
  preshared key     ${S[PSK]}$([[ ${S[PSK]} == yes ]] && echo " (site.psk)")
  MTU / keepalive   $H_MTU / $KEEPALIVE s
  allowed           only TCP $NVR_PORT (TVT SDK) and ping from $HUB_IP to the site LAN; nothing else,
                    and nothing from the site into the tunnel

Linux gateway (Raspberry Pi OS, Debian, Ubuntu), on the site box as root:
  tar -xzf $1.tar.gz
  bash $1/site-gateway.sh check   $1.tar.gz
  bash $1/site-gateway.sh install $1.tar.gz$([[ $2 == yes ]] || echo " --key /root/cctv-site.key")
Router, firewall or Windows PC (filled-in steps for that device):
  bash $1/site-recipes.sh $1.tar.gz mikrotik|openwrt|rutos|pfsense|opnsense|edgeos|unifi|windows [--nvr IP,IP]
  or import wg0.conf by hand and follow deploy/vpn/README.md.
Test: the gateway shows a WireGuard handshake less than 2 minutes old (ping $HUB_IP is NOT answered,
by design). Then, in the CCTV app, add each NVR as 10.78.$id.<last octet of its LAN address>, port $NVR_PORT.
EOF
}
cmd_site_bundle() {
  local target out="" forget=0 nokey=0 ep_opt="" id folder work key="" psk="" tmp sum size f dest vd dd
  (($# >= 1)) || die 2 "usage: $PROG site-bundle NAME|ID [--out FILE.tar.gz|-] [--forget-key] [--no-key] [--endpoint HOST[:PORT]]"
  target=$1
  shift
  while (($#)); do
    case $1 in
      --out) (($# >= 2)) || die 2 "--out needs a value"; out=$2; shift 2 ;;
      --forget-key) forget=1; shift ;;
      --no-key) nokey=1; shift ;;
      --endpoint) (($# >= 2)) || die 2 "--endpoint needs a value"; ep_opt=$2; shift 2 ;;
      *) die 2 "site-bundle: unknown option $(q "$1")" ;;
    esac
  done
  ((!(forget && nokey))) || die 2 "--forget-key and --no-key exclude each other"
  EP_HOST="" EP_PORT=""
  [[ -z $ep_opt ]] || parse_endpoint_arg "$ep_opt"
  if [[ -n $out && $out != - ]]; then
    [[ $out =~ ^[A-Za-z0-9._/+@-]+$ && $out != *..* ]] || die 2 "--out: use a plain path (letters, digits, . _ - / + @)"
    [[ $out == *.tar.gz || $out == *.tgz ]] || die 2 "--out must end in .tar.gz or .tgz (the gateway script expects that)"
    [[ $out == /* ]] || out=$PWD/$out
    [[ -d ${out%/*} ]] || die 2 "--out: folder ${out%/*} does not exist"
    [[ ! -d $out ]] || die 2 "--out is a folder"
  fi
  if [[ $out == - ]]; then
    [[ ! -t 1 ]] || die 2 "--out - writes a binary archive to stdout: redirect it (> file) or pipe it"
    ((!forget)) || die 2 "--forget-key needs a file (--out FILE): this tool cannot tell whether a pipe's reader kept the bundle"
  fi
  if ((forget)); then
    # a bundle kept under /etc/cctv/vpn would still hold the key the hub is meant to forget
    [[ -n $out ]] || die 2 "--forget-key needs --out FILE outside $VPN_DIR (a transfer folder or a USB stick): a bundle in $BUNDLES would still hold the key"
    vd=$(realpath -m "$VPN_DIR")
    dd=$(realpath -m "${out%/*}")
    [[ $dd != "$vd" && $dd != "$vd"/* ]] || die 2 "--forget-key: --out must be outside $VPN_DIR (a bundle kept there would still hold the key)"
  fi
  need_root
  load_hub
  lock
  find_site "$target"
  id=$FOUND
  if [[ -n $EP_HOST ]]; then
    B_HINT=$(ep_join "$EP_HOST" "${EP_PORT:-$H_PUBLIC_PORT}")
    endpoint_warning "$EP_HOST"
  else
    B_HINT=$HUB_HINT
  fi
  [[ -n $B_HINT ]] || die 3 "the hub has no public endpoint yet: $PROG hub-init --endpoint <public IP or DNS name of the main site>"
  if [[ ${S[KEY_ORIGIN]} == forgotten ]] && ((!nokey)); then
    die 3 "site $id (${S[NAME]}): its private key was exported on ${S[EXPORTED]} and then forgotten on this hub, so a new bundle cannot hold it. If the gateway still has its key: site-bundle ${S[NAME]} --no-key (install it with --key). Otherwise: $PROG site-rekey ${S[NAME]} --yes, then a new bundle"
  fi
  if [[ ${S[KEY_ON_HUB]} == yes ]] && ((!nokey)); then key=$(read_key_file "$SITES/$id/private.key") || die 1 "site $id: private.key missing or bad"; fi
  if [[ ${S[PSK]} == yes ]]; then psk=$(read_key_file "$SITES/$id/psk") || die 1 "site $id: psk missing or bad"; fi
  folder=cctv-site-$id-${S[NAME]}
  work=$(mktemp -d "$BUNDLES/.work.XXXXXX")
  CLEANUP_DIRS+=("$work")
  mkdir -m 0700 "$work/$folder"
  render_site_env >"$work/$folder/site.env"
  render_bundle_wgconf "$key" "$psk" >"$work/$folder/wg0.conf"
  render_bundle_readme "$folder" "$([[ -n $key ]] && echo yes || echo no)" >"$work/$folder/README.txt"
  [[ -z $key ]] || printf '%s\n' "$key" >"$work/$folder/site.key"
  [[ -z $psk ]] || printf '%s\n' "$psk" >"$work/$folder/site.psk"
  for f in site-gateway.sh site-recipes.sh; do
    if [[ -f $SHARE/gateway/$f ]]; then cp "$SHARE/gateway/$f" "$work/$folder/$f"; fi
  done
  chmod 600 "$work/$folder"/*
  if [[ $out == - ]]; then
    tar -C "$work" --owner=0 --group=0 --numeric-owner -czf - "$folder"
    echo "bundle for site $id (${S[NAME]}) written to stdout; copy it to the site over a secure channel, then delete it" >&2
    return 0
  fi
  dest=${out:-$BUNDLES/$folder.tar.gz}
  tmp=$(mktemp "${dest%/*}/.bundle.XXXXXX")
  tar -C "$work" --owner=0 --group=0 --numeric-owner -czf "$tmp" "$folder"
  chmod 600 "$tmp"
  sync "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$dest"
  sync "${dest%/*}" 2>/dev/null || true
  size=$(stat -c %s "$dest")
  sum=$(sha256sum "$dest" | awk '{print $1}')
  [[ -z $key ]] || S[EXPORTED]=$(now_iso)
  if ((forget)) && [[ ${S[KEY_ON_HUB]} == yes ]]; then
    # only now that the archive is complete and on disk
    tar -tzf "$dest" "$folder/site.key" >/dev/null 2>&1 || die 1 "the bundle does not read back: the key was NOT forgotten"
    rm -f -- "$SITES/$id/private.key"
    S[KEY_ON_HUB]=no S[KEY_ORIGIN]=forgotten
    mark_changed
  fi
  save_site "$SITES/$id"
  echo "bundle for site $id (${S[NAME]}): $dest"
  echo "  $size bytes, sha256 $sum; it dials $B_HINT"
  if ((forget)); then
    if [[ ${S[KEY_ORIGIN]} == forgotten && -n $key ]]; then warn "the site's private key is no longer on this hub: this bundle is now the ONLY copy"; else echo "  (the site's private key was not on this hub anyway)"; fi
  fi
  if [[ -n $key ]]; then
    echo "  it holds the site's private key: whoever copies it can stand in for this site's gateway (and"
    echo "  receive the app's NVR logins for it). Copy it to the site over a secure channel, install it, delete every copy."
  fi
  echo "  at the site: tar -xzf ${dest##*/} && sudo bash $folder/site-gateway.sh install ${dest##*/}$([[ -n $key ]] || echo " --key <its own key file>")"
}
cmd_site_list() {
