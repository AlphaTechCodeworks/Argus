Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$nft -f /etc/cctv/vpn/cctv_vpn.nft
# no ExecStop on purpose: the table (and its "VPN addresses never leave by another interface"
# rule) stays loaded while $IF is down; only \`cctv-vpn hub-purge\` deletes it

[Install]
WantedBy=multi-user.target
EOF
  cat >"$UNIT_DIR/wg-quick@$IF.service.d/cctv-vpn.conf" <<EOF
# CCTV VPN hub (written by cctv-vpn hub-init): $IF only ever runs with its firewall loaded.
# Stopping or failing $FW_UNIT stops $IF too (Requires=).
[Unit]
Requires=$FW_UNIT
After=$FW_UNIT
EOF
  cat >"$UNIT_DIR/nftables.service.d/cctv-vpn.conf" <<EOF
# CCTV VPN hub (written by cctv-vpn hub-init): nftables.service starts and reloads with
# "flush ruleset", which would also delete table inet $TABLE. Put it straight back.
# (Harmless if nftables.service is never used.)
[Service]
ExecStartPost=-$nft -f /etc/cctv/vpn/cctv_vpn.nft
ExecReload=-$nft -f /etc/cctv/vpn/cctv_vpn.nft
EOF
  cat >"$UNIT_DIR/$ST_UNIT" <<EOF
# Writes /run/cctv/vpn-status.json for the CCTV app (no secrets), keeps the last site endpoints
# and checks that table inet $TABLE is exactly as generated (reloads it if not; takes $IF down if
# that fails). Run every 15 s by the timer; $WATCH_UNIT reacts to changes at once.
[Unit]
Description=CCTV VPN status for the app (/run/cctv/vpn-status.json)
After=$FW_UNIT wg-quick@$IF.service
ConditionPathExists=/etc/cctv/vpn/hub.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cctv-vpn status --write
# every 15 s: keep "Starting/Finished" out of the journal; warnings and errors still get through
LogLevelMax=notice
UMask=0077
# /var/lib/cctv-vpn: last known site endpoints (restored when $IF comes back up)
StateDirectory=cctv-vpn
StateDirectoryMode=0700
# root, but only what wg/nft/ip need (netlink with CAP_NET_ADMIN) and ping (CAP_NET_RAW, for the
# idle-session ping to a gateway's tunnel address); /run/cctv is made by tmpfiles
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/cctv
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# netlink for wg/nft/ip; AF_INET/AF_INET6 for the idle-session ping and the WSL port claim (a bind
# that is meant to fail)
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
TimeoutStartSec=10
EOF
  cat >"$UNIT_DIR/$TIMER_UNIT" <<EOF
[Unit]
Description=CCTV VPN status every 15 s

[Timer]
OnBootSec=10s
OnUnitActiveSec=15s
# the default (1 min) would bunch the runs up: the app calls a status older than 90 s stale
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF
  cat >"$UNIT_DIR/$WATCH_UNIT" <<EOF
