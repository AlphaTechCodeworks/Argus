cmd_status() {
  local opt=${1:-} n id t k now state fw
  (($# <= 1)) || die 2 "usage: $PROG status [--json|--write]"
  need_root
  case $opt in
    --json) status_json; return 0 ;;
    --write) status_write; return $? ;;
    "") ;;
    *) die 2 "status: unknown option $(q "$opt")" ;;
  esac
  load_hub
  local -A hs=() rx=() tx=() ep=()
  local a b
  if wg_exists; then
    while read -r k a; do valid_key "$k" && valid_uint "$a" && hs[$k]=$a; done < <(wg show "$IF" latest-handshakes 2>/dev/null || true)
    while read -r k a b; do valid_key "$k" && valid_uint "$a" && valid_uint "$b" && rx[$k]=$a && tx[$k]=$b; done < <(wg show "$IF" transfer 2>/dev/null || true)
    while read -r k a; do valid_key "$k" && ep[$k]=$a; done < <(wg show "$IF" endpoints 2>/dev/null || true)
    state="up"
    [[ $(ip -o link show dev "$IF" 2>/dev/null) == *"<"*UP*">"* ]] || state="DOWN (link down: $PROG hub-up)"
  else
    state="DOWN"
  fi
  case $(fw_state) in
    ok) fw="ok (exactly as generated)" ;;
    missing) fw="MISSING" ;;
    differs) fw="CHANGED outside $PROG" ;;
    *) fw="loaded (not compared yet)" ;;
  esac
  echo "hub  $IF $state, UDP $H_PORT, sites dial ${HUB_HINT:-(no endpoint set)}, firewall $fw, ip_forward $(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo '?')"
  echo "     UDP $H_PORT packets received: $(counter_of wg_udp_in || true); handshake initiations received: $(counter_of wg_handshake_in || true) (since the last firewall load)"
  now=$(date +%s)
  printf '%-4s %-24s %-11s %-15s %-16s %-10s %-10s %-22s %s\n' ID NAME TUNNEL VIRTUAL REAL-LAN STATE HANDSHAKE ENDPOINT "RX / TX"
  for id in $(site_ids); do
    load_site "$id" P || { printf '%-4s %s\n' "$id" "(damaged record)"; continue; }
    k=${P[PUBLIC_KEY]}
    t=${hs[$k]:-0}
    if ((t == 0)); then n="never"; a="-"; elif ((now - t < CONNECTED_S)); then n="connected"; a="$((now - t)) s ago"; else n="stale"; a="$((now - t)) s ago"; fi
    printf '%-4s %-24s %-11s %-15s %-16s %-10s %-10s %-22s %s / %s\n' "$id" "${P[NAME]}" "10.77.0.$id" "10.78.$id.0/24" "${P[LAN]}" "$n" "$a" "${ep[$k]:-(none)}" "$(human_bytes "${rx[$k]:-0}")" "$(human_bytes "${tx[$k]:-0}")"
  done
}
