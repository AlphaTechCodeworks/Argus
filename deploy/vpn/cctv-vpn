# fw-verify: by hand, and as wg0's PreUp (--preup: quiet when all is well; a failure stops wg0 from
# starting). The PreUp runs in a child of wg-quick: when the table is fine it needs no lock (the
# command that started wg0 may hold it); only a repair waits for the lock.
cmd_fw_verify() {
  local preup=0 st
  if [[ ${1:-} == --preup ]]; then preup=1; shift; fi
  (($# == 0)) || die 2 "fw-verify: unknown option $(q "$1")"
  need_root
  load_hub
  st=$(fw_state)
  if [[ $st == ok ]]; then
    ((preup)) || echo "table inet $TABLE is exactly as generated"
    return 0
  fi
  local what
  case $st in missing) what="is missing" ;; differs) what="was changed outside $PROG" ;; *) what="was not compared yet" ;; esac
  guard_lock 10 || die 1 "table inet $TABLE $what and another $PROG command holds the lock: refusing to go on without the firewall"
  st=$(fw_state)
  if [[ $st != ok ]]; then
    [[ $st == unknown ]] || warn "table inet $TABLE $what$([[ $st == differs ]] && echo " ($(fw_diff))"): loading the generated one"
    if ! fw_load || [[ $(fw_state) != ok ]]; then
      guard_unlock
      ((preup)) || wg_fail_closed
      die 1 "could not load table inet $TABLE: $IF must not run without it"
    fi
  fi
  guard_unlock
  ((preup)) || echo "table inet $TABLE $what: the generated table is loaded again"
}
# fw-watch: the watcher unit. nft monitor reports every ruleset change at once; after a burst of
# events has settled (0.3 s) the guard compares and, if needed, loads the table again. Its own
# reload causes events too, and the next comparison then finds the table as generated.
cmd_fw_watch() {
  (($# == 0)) || die 2 "fw-watch takes no options"
  need_root
  need_tools nft
  load_hub
  guard_firewall || true
  while :; do
    while IFS= read -r _; do
      while IFS= read -r -t 0.3 _; do :; done
      [[ -f $VPN_DIR/hub.conf ]] || exit 0 # purged
      load_hub                              # hub-init may have changed the port
      guard_firewall || true
    done < <(nft monitor 2>/dev/null)
    sleep 1 # nft monitor ended: start it again
  done
}

# ---------------------------------------------------------------- backup and restore
# A backup holds the hub key, every site record and key, the retired ids and the saved site
# endpoints: enough to rebuild the hub on a new machine with no change at any site (the sites keep
# dialing the same address with the same keys). Encrypted with gpg (AES256, passphrase) unless
# --no-encrypt. Never kept under /etc/cctv/vpn.
backup_members() { # paths relative to the root, one per line
  local f id
  for f in hub.conf hub.key hub.pub; do [[ -f $VPN_DIR/$f ]] && echo "${VPN_DIR#"$ROOT"/}/$f"; done
  for id in $(site_ids); do
    for f in site.conf public.key private.key psk; do [[ -f $SITES/$id/$f ]] && echo "${SITES#"$ROOT"/}/$id/$f"; done
  done
  for id in $(retired_ids); do echo "${RETIRED#"$ROOT"/}/$id.conf"; done
  if [[ -f $STATE_DIR/endpoints ]]; then echo "${STATE_DIR#"$ROOT"/}/endpoints"; fi
  return 0
}
read_passphrase() { # $1 passphrase file or empty, $2 ask twice (1) -> PASS
  PASS=""
  if [[ -n $1 ]]; then
    [[ -f $1 && ! -L $1 ]] || die 2 "--passphrase-file $(q "$1"): not a plain file"
    PASS=$(head -n1 -- "$1" | tr -d '\r')
  else
    [[ -t 0 ]] || die 2 "no terminal to ask for the passphrase: give --passphrase-file FILE"
    local again
    read -rs -p "backup passphrase: " PASS && echo >&2
    if (($2)); then
      read -rs -p "the same again: " again && echo >&2
      [[ $PASS == "$again" ]] || die 2 "the two passphrases differ"
    fi
  fi
  ((${#PASS} >= 12)) || die 2 "the passphrase must have at least 12 characters"
}
gpg_home() { # a temporary gpg home (its agent is stopped on exit) -> GHOME
  local rd
  rd=/run/user/$(id -u)/gnupg
  [[ -e $rd || ! -d ${rd%/gnupg} ]] || GPG_RUNDIR=$rd # gpg-agent puts its sockets there
  GHOME=$(mktemp -d "${TMPDIR:-/tmp}/cctv-vpn-gpg.XXXXXX")
  GPG_HOMES+=("$GHOME")
  CLEANUP_DIRS+=("$GHOME")
}
PASS="" GHOME=""
cmd_backup() {
  local out="" passfile="" noenc=0 vd dd tmpd host n tmp sum size last_change
  local -a members=()
  while (($#)); do
    case $1 in
      --out) (($# >= 2)) || die 2 "--out needs a value"; out=$2; shift 2 ;;
      --passphrase-file) (($# >= 2)) || die 2 "--passphrase-file needs a value"; passfile=$2; shift 2 ;;
      --no-encrypt) noenc=1; shift ;;
      *) die 2 "backup: unknown option $(q "$1")" ;;
    esac
  done
  [[ -n $out ]] || die 2 "backup: --out FILE is required (then keep the file on another machine or a USB stick)"
  [[ $out =~ ^[A-Za-z0-9._/+@-]+$ && $out != *..* ]] || die 2 "--out: use a plain path (letters, digits, . _ - / + @)"
  if ((noenc)); then
    [[ -z $passfile ]] || die 2 "--no-encrypt takes no passphrase"
    [[ $out == *.tar.gz ]] || die 2 "--out must end in .tar.gz with --no-encrypt"
  else
    [[ $out == *.tar.gz.gpg ]] || die 2 "--out must end in .tar.gz.gpg (encrypted; --no-encrypt writes a plain .tar.gz)"
  fi
  [[ $out == /* ]] || out=$PWD/$out
  [[ -d ${out%/*} ]] || die 2 "--out: folder ${out%/*} does not exist"
  [[ ! -e $out ]] || die 3 "--out $(q "$out") exists already: a backup is never overwritten, choose a new name"
  vd=$(realpath -m "$VPN_DIR")
  dd=$(realpath -m "${out%/*}")
  [[ $dd != "$vd" && $dd != "$vd"/* ]] || die 2 "--out must be outside $VPN_DIR"
  need_root
  need_tools tar gzip sha256sum
  ((noenc)) || need_tools gpg gpgconf
  load_hub
  lock
  ((noenc)) || read_passphrase "$passfile" 1
  mapfile -t members < <(backup_members)
  ((${#members[@]} >= 3)) || die 1 "nothing to back up (no hub key?)"
  n=$(site_ids | wc -l)
  tmpd=$(mktemp -d "${TMPDIR:-/tmp}/cctv-vpn-backup.XXXXXX")
  CLEANUP_DIRS+=("$tmpd")
  host=$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9.-' | cut -c1-63)
  write_kv_file "$tmpd/cctv-vpn-backup.conf" "BACKUP=1" "CREATED=$(now_iso)" "HOST=${host:-hub}" "HUB_PUBLIC_KEY=$HUB_PUB" "SITES=$n"
  tar --owner=0 --group=0 --numeric-owner -czf "$tmpd/b.tar.gz" -C "$tmpd" cctv-vpn-backup.conf -C "${ROOT:-/}" "${members[@]}"
  if ((noenc)); then
    mv "$tmpd/b.tar.gz" "$tmpd/out"
  else
    gpg_home
    HOME=$GHOME gpg --homedir "$GHOME" --batch --yes --quiet --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3 \
      --symmetric --cipher-algo AES256 --output "$tmpd/out" "$tmpd/b.tar.gz" 3< <(printf '%s\n' "$PASS") ||
      die 1 "gpg could not encrypt the backup: nothing written"
    # read it back before calling it a backup
    HOME=$GHOME gpg --homedir "$GHOME" --batch --quiet --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3 \
      --decrypt "$tmpd/out" 3< <(printf '%s\n' "$PASS") 2>/dev/null | cmp -s - "$tmpd/b.tar.gz" ||
      die 1 "the encrypted backup does not read back: nothing written"
  fi
  tmp=$(mktemp "${out%/*}/.cctv-vpn-backup.XXXXXX")
  cat "$tmpd/out" >"$tmp"
  chmod 600 "$tmp"
  sync "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$out"
  size=$(stat -c %s "$out")
  sum=$(sha256sum "$out" | awk '{print $1}')
  local -A B=()
  last_change=$(now_iso)
  if read_record "$BACKUP_CONF" B && valid_time "${B[LAST_CHANGE]:-}"; then last_change=${B[LAST_CHANGE]}; fi
  write_kv_file "$BACKUP_CONF" "LAST_BACKUP=$(now_iso)" "LAST_CHANGE=$last_change"
  echo "backup of the hub (key $HUB_PUB, $n site(s)): $out"
  echo "  $size bytes, sha256 $sum"
  if ((noenc)); then
    warn "this file holds every private key IN PLAIN: keep it only on an encrypted medium"
  else
    echo "  encrypted (gpg, AES256): without the passphrase it is useless, so keep the passphrase apart from it"
  fi
  echo "  Keep it OFF this machine (another computer, a USB stick in a safe). A new one is needed after every"
  echo "  site-add / site-remove / site-rekey / hub-rekey ($PROG check, item 14, says when)."
  echo "  Rebuild a hub from it: $PROG restore ${out##*/}   (on the new machine; no site needs a visit)"
}
cmd_restore() {
  local file="" passfile="" tmpd x m names types n=0 id f k e
  (($# >= 1)) || die 2 "usage: $PROG restore FILE.tar.gz.gpg|FILE.tar.gz [--passphrase-file F]"
  file=$1
  shift
  while (($#)); do
    case $1 in
      --passphrase-file) (($# >= 2)) || die 2 "--passphrase-file needs a value"; passfile=$2; shift 2 ;;
      *) die 2 "restore: unknown option $(q "$1")" ;;
    esac
  done
  [[ $file =~ ^[A-Za-z0-9._/+@-]+$ && $file != *..* ]] || die 2 "restore: use a plain path (letters, digits, . _ - / + @)"
  [[ $file == *.tar.gz.gpg || $file == *.tar.gz ]] || die 2 "restore: a backup ends in .tar.gz.gpg (or .tar.gz)"
  [[ -f $file && ! -L $file ]] || die 4 "restore: $(q "$file") not found"
  (($(stat -c %s "$file") <= 20971520)) || die 2 "restore: bigger than 20 MB, not a hub backup"
  need_root
  need_tools tar gzip wg
  local fl
  for fl in "$VPN_DIR/hub.key" "$VPN_DIR/hub.conf"; do
    [[ ! -e $fl ]] || die 3 "a hub is already set up here ($fl): restore only onto a machine without one (to replace this one: $PROG hub-purge --yes --delete-keys first)"
  done
  if [[ -n $(site_ids 2>/dev/null) || -n $(retired_ids 2>/dev/null) ]]; then die 3 "$SITES or $RETIRED holds records already: refusing to mix them with a backup"; fi
  tmpd=$(mktemp -d "${TMPDIR:-/tmp}/cctv-vpn-restore.XXXXXX")
  CLEANUP_DIRS+=("$tmpd")
  if [[ $file == *.gpg ]]; then
    need_tools gpg gpgconf
    read_passphrase "$passfile" 0
    gpg_home
    HOME=$GHOME gpg --homedir "$GHOME" --batch --quiet --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3 \
      --output "$tmpd/b.tar.gz" --decrypt "$file" 3< <(printf '%s\n' "$PASS") 2>"$tmpd/gpg.err" ||
      die 1 "cannot decrypt $(q "$file") (wrong passphrase, or not a cctv-vpn backup): nothing changed"
  else
    cp -- "$file" "$tmpd/b.tar.gz"
  fi
  # only plain files and folders, only the names a backup has
  names=$(tar -tzf "$tmpd/b.tar.gz" 2>/dev/null) || die 1 "not a readable archive: nothing changed"
  types=$(tar -tvzf "$tmpd/b.tar.gz" | cut -c1 | sort -u | tr -d '\n')
  [[ $types =~ ^[-d]+$ ]] || die 2 "the backup holds links or special files: refused, nothing changed"
  while IFS= read -r m; do
    [[ $m =~ ^(cctv-vpn-backup\.conf|etc/|etc/cctv/|etc/cctv/vpn/|etc/cctv/vpn/(hub\.conf|hub\.key|hub\.pub)|etc/cctv/vpn/(sites|retired)/|etc/cctv/vpn/sites/[0-9]{1,3}/|etc/cctv/vpn/sites/[0-9]{1,3}/(site\.conf|public\.key|private\.key|psk)|etc/cctv/vpn/retired/[0-9]{1,3}\.conf|var/|var/lib/|var/lib/cctv-vpn/|var/lib/cctv-vpn/endpoints)$ ]] ||
      die 2 "unexpected entry in the backup: $(q "$m"): refused, nothing changed"
  done <<<"$names"
  x=$tmpd/x
  mkdir -m 0700 "$x"
  tar -xzf "$tmpd/b.tar.gz" -C "$x" --no-same-owner --no-same-permissions
  local -A M=()
  read_record "$x/cctv-vpn-backup.conf" M && [[ ${M[BACKUP]:-} == 1 ]] && valid_time "${M[CREATED]:-}" ||
    die 2 "not a cctv-vpn backup (cctv-vpn-backup.conf missing or wrong): nothing changed"
  # check everything in the copy before anything is put in place (the loaders follow these paths)
  local real_vpn=$VPN_DIR real_sites=$SITES real_ret=$RETIRED hk hp
  VPN_DIR=$x/etc/cctv/vpn SITES=$x/etc/cctv/vpn/sites RETIRED=$x/etc/cctv/vpn/retired
  load_hub
  hk=$(read_key_file "$VPN_DIR/hub.key") || die 2 "the backup's hub.key is missing or not a key"
  hp=$(printf '%s' "$hk" | wg pubkey)
  [[ $hp == "$HUB_PUB" && $hp == "${M[HUB_PUBLIC_KEY]:-}" ]] || die 2 "the backup's hub.key does not match its hub.pub: refused"
  for id in $(site_ids); do
    load_site "$id" P || die 2 "the backup's record of site $id is damaged: refused"
    [[ $(read_key_file "$SITES/$id/public.key" || true) == "${P[PUBLIC_KEY]}" ]] || die 2 "site $id: public.key does not match its record"
    if [[ ${P[KEY_ON_HUB]} == yes ]]; then
      k=$(read_key_file "$SITES/$id/private.key") || die 2 "site $id: private.key missing or bad"
      [[ $(printf '%s' "$k" | wg pubkey) == "${P[PUBLIC_KEY]}" ]] || die 2 "site $id: private.key does not match its public key"
    fi
    if [[ ${P[PSK]} == yes ]]; then read_key_file "$SITES/$id/psk" >/dev/null || die 2 "site $id: psk missing or bad"; fi
    n=$((n + 1))
  done
  for id in $(retired_ids); do load_retired "$id" || die 2 "the backup's retired record $id is damaged: refused"; done
  VPN_DIR=$real_vpn SITES=$real_sites RETIRED=$real_ret
  # put it in place
  install -d -m 0700 "$VPN_DIR" "$SITES" "$RETIRED" "$BUNDLES"
  lock
  for f in hub.conf hub.key hub.pub; do install -m 0600 "$x/etc/cctv/vpn/$f" "$VPN_DIR/$f"; done
  for m in "$x"/etc/cctv/vpn/sites/*/; do
    [[ -d $m ]] || continue
    id=${m%/}
    id=${id##*/}
    valid_id "$id" || continue
    install -d -m 0700 "$SITES/.new-$id"
    for f in site.conf public.key private.key psk; do [[ ! -f $m$f ]] || install -m 0600 "$m$f" "$SITES/.new-$id/$f"; done
    mv -T "$SITES/.new-$id" "$SITES/$id"
  done
  for m in "$x"/etc/cctv/vpn/retired/*.conf; do [[ ! -f $m ]] || install -m 0600 "$m" "$RETIRED/${m##*/}"; done
  if [[ -f $x/var/lib/cctv-vpn/endpoints ]]; then
    install -d -m 0700 "$STATE_DIR"
    while read -r k e; do if valid_key "$k" && valid_endpoint "$e"; then printf '%s %s\n' "$k" "$e"; fi; done <"$x/var/lib/cctv-vpn/endpoints" >"$STATE_DIR/endpoints"
    chmod 600 "$STATE_DIR/endpoints"
  fi
  write_kv_file "$BACKUP_CONF" "LAST_BACKUP=${M[CREATED]}" "LAST_CHANGE=${M[CREATED]}"
  echo "restored the hub from $(q "${file##*/}") (made ${M[CREATED]} on ${M[HOST]:-?}): hub key $HUB_PUB, $n site(s)"
  echo "== hub-init with the restored settings"
  cmd_hub_init
}

[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0 # sourced (tests): functions only
cmd=${1:-help}
shift || true
case $cmd in
  hub-init) cmd_hub_init "$@" ;;
  hub-info) cmd_hub_info "$@" ;;
  hub-up) cmd_hub_up "$@" ;;
  hub-down) cmd_hub_down "$@" ;;
  hub-rekey) cmd_hub_rekey "$@" ;;
  hub-purge) cmd_hub_purge "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  firewall-reload) cmd_firewall_reload "$@" ;;
  fw-verify) cmd_fw_verify "$@" ;;
  fw-watch) cmd_fw_watch "$@" ;;
  site-add) cmd_site_add "$@" ;;
  site-set) cmd_site_set "$@" ;;
  site-remove) cmd_site_remove "$@" ;;
  site-rekey) cmd_site_rekey "$@" ;;
  site-reset) cmd_site_reset "$@" ;;
  site-bundle) cmd_site_bundle "$@" ;;
  site-list) cmd_site_list "$@" ;;
  status) cmd_status "$@" ;;
  check) cmd_check "$@" ;;
  post-up) cmd_post_up "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
