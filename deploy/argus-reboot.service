# Started by argus-reboot.path. No [Install]: never enabled on its own.
[Unit]
Description=Argus: reboot requested from the CCTV app
# a request that keeps coming back (it cannot, the script deletes it first) is stopped here
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/argus-reboot
TimeoutStartSec=30
SyslogIdentifier=argus-reboot
